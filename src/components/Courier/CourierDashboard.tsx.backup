import React, { useEffect, useState } from 'react';
import {
    FaBox,
    FaCheckCircle,
    FaClock,
    FaExclamationTriangle,
    FaMapMarkedAlt,
    FaPills,
    FaRoute,
    FaSignOutAlt,
    FaSpinner,
    FaTimesCircle,
    FaTruck,
    FaUser
} from 'react-icons/fa';
import { useParams } from 'react-router-dom';
import {
    CourierDashboardStats,
    CourierDelivery,
    courierService,
    User
} from '../../services/api';
import AuthService from '../../services/auth';
import { StatCard } from '../StatCard';
import { Tabs } from '../Tabs';

type TabKey = 'Assignées' | 'En Cours' | 'Historique';

// Delivery status badge component
const DeliveryStatusBadge: React.FC<{ status: string }> = ({ status }) => {
  const getStatusStyle = (status: string) => {
    const upperStatus = status.toUpperCase();
    switch (upperStatus) {
      case 'DISPATCHED':
        return 'bg-yellow-100 text-yellow-800';
      case 'IN_TRANSIT':
        return 'bg-blue-100 text-blue-800';
      case 'DELIVERED':
        return 'bg-green-100 text-green-800';
      default:
        return 'bg-gray-100 text-gray-800';
    }
  };

  const getStatusText = (status: string) => {
    const upperStatus = status.toUpperCase();
    switch (upperStatus) {
      case 'DISPATCHED':
        return 'Prêt à récupérer';
      case 'IN_TRANSIT':
        return 'En livraison';
      case 'DELIVERED':
        return 'Livré';
      default:
        return status;
    }
  };

  return (
    <span className={`px-2 py-1 text-xs font-medium rounded-full ${getStatusStyle(status)}`}>
      {getStatusText(status)}
    </span>
  );
};

// Delivery card component
const DeliveryCard: React.FC<{
  delivery: CourierDelivery;
  onStatusUpdate: (deliveryId: number, status: 'DISPATCHED' | 'IN_TRANSIT' | 'DELIVERED') => void;
  onAccept: (deliveryId: number) => void;
  onRefuse: (deliveryId: number) => void;
  isUpdating: boolean;
  showActions: boolean;
}> = ({ delivery, onStatusUpdate, onAccept, onRefuse, isUpdating, showActions }) => {
  
  const getNextStatus = (currentStatus: string): 'DISPATCHED' | 'IN_TRANSIT' | 'DELIVERED' | null => {
    const upperStatus = currentStatus.toUpperCase();
    switch (upperStatus) {
      case 'DISPATCHED':
        return 'IN_TRANSIT';
      case 'IN_TRANSIT':
        return 'DELIVERED';
      default:
        return null;
    }
  };

  const getNextStatusText = (currentStatus: string): string => {
    const nextStatus = getNextStatus(currentStatus);
    switch (nextStatus) {
      case 'IN_TRANSIT':
        return 'Commencer la livraison';
      case 'DELIVERED':
        return 'Marquer comme livré';
      default:
        return 'Terminé';
    }
  };

  const nextStatus = getNextStatus(delivery.status);

  const openGoogleMaps = (address: string) => {
    const encodedAddress = encodeURIComponent(address);
    window.open(`https://www.google.com/maps/search/?api=1&query=${encodedAddress}`, '_blank');
  };

  const openDirections = (fromAddress: string, toAddress: string) => {
    const encodedFrom = encodeURIComponent(fromAddress);
    const encodedTo = encodeURIComponent(toAddress);
    window.open(`https://www.google.com/maps/dir/${encodedFrom}/${encodedTo}`, '_blank');
  };

  return (
    <div className="bg-white rounded-lg border shadow-sm hover:shadow-md transition-shadow">
      <div className="p-6">
        <div className="flex justify-between items-start mb-4">
          <div>
            <h3 className="text-lg font-semibold text-gray-800">
              Livraison #{delivery.code || delivery.id}
            </h3>
            <p className="text-sm text-gray-500">
              {new Date(delivery.date).toLocaleDateString('fr-FR')}
            </p>
          </div>
          <DeliveryStatusBadge status={delivery.status} />
        </div>

        {/* Patient Information */}
        <div className="mb-4 p-3 bg-blue-50 rounded-lg">
          <div className="flex items-center mb-2">
            <FaUser className="mr-2 text-blue-600" size={14} />
            <span className="text-sm font-medium text-blue-800">
              Patient: {delivery.patient.firstName} ({delivery.patient.email})
            </span>
          </div>
          {delivery.patient.address && (
            <div className="text-sm text-blue-700">
              📍 Adresse: {delivery.patient.address}
            </div>
          )}
        </div>

        {/* Pharmacy Information */}
        <div className="mb-4 p-3 bg-green-50 rounded-lg">
          <div className="flex items-center mb-2">
            <FaPills className="mr-2 text-green-600" size={14} />
            <span className="text-sm font-medium text-green-800">
              Pharmacie: {delivery.pharmacy.name}
            </span>
          </div>
          <div className="text-sm text-green-700">
            📍 {delivery.pharmacy.address}
          </div>
        </div>

        {/* Medications */}
        <div className="mb-4">
          <h4 className="text-sm font-medium text-gray-700 mb-2">Médicaments:</h4>
          <div className="flex flex-wrap gap-2">
            {delivery.prescription.medicaments.map((medicament, index) => (
              <span
                key={index}
                className="inline-flex items-center px-2 py-1 text-xs bg-purple-50 text-purple-700 rounded-full"
              >
                <FaPills className="mr-1" size={10} />
                {medicament.nom}
              </span>
            ))}
          </div>
        </div>

        {/* Action Buttons */}
        <div className="flex flex-wrap gap-2">
          {/* Accept/Refuse for new assignments */}
          {showActions && delivery.status.toUpperCase() === 'DISPATCHED' && (
            <>
              <button
                onClick={() => onAccept(delivery.id)}
                disabled={isUpdating}
                className="flex items-center px-3 py-2 text-sm text-white bg-green-600 rounded hover:bg-green-700 disabled:bg-gray-400"
              >
                <FaCheckCircle className="mr-1" size={12} />
                Accepter
              </button>
              <button
                onClick={() => onRefuse(delivery.id)}
                disabled={isUpdating}
                className="flex items-center px-3 py-2 text-sm text-white bg-red-600 rounded hover:bg-red-700 disabled:bg-gray-400"
              >
                <FaTimesCircle className="mr-1" size={12} />
                Refuser
              </button>
            </>
          )}

          {/* Status progression */}
          {nextStatus && !showActions && (
            <button
              onClick={() => onStatusUpdate(delivery.id, nextStatus)}
              disabled={isUpdating}
              className="flex items-center px-3 py-2 text-sm text-white bg-blue-600 rounded hover:bg-blue-700 disabled:bg-gray-400"
            >
              {isUpdating ? (
                <>
                  <FaSpinner className="mr-1 animate-spin" size={12} />
                  Mise à jour...
                </>
              ) : (
                getNextStatusText(delivery.status)
              )}
            </button>
          )}

          {/* Map buttons */}
          <button
            onClick={() => openGoogleMaps(delivery.pharmacy.address)}
            className="flex items-center px-3 py-2 text-sm text-gray-700 bg-gray-100 rounded hover:bg-gray-200"
          >
            <FaMapMarkedAlt className="mr-1" size={12} />
            Pharmacie
          </button>
          
          {delivery.patient.address && (
            <>
              <button
                onClick={() => openGoogleMaps(delivery.patient.address!)}
                className="flex items-center px-3 py-2 text-sm text-gray-700 bg-gray-100 rounded hover:bg-gray-200"
              >
                <FaUser className="mr-1" size={12} />
                Patient
              </button>
              
              <button
                onClick={() => openDirections(delivery.pharmacy.address, delivery.patient.address!)}
                className="flex items-center px-3 py-2 text-sm text-white bg-purple-600 rounded hover:bg-purple-700"
              >
                <FaRoute className="mr-1" size={12} />
                Itinéraire
              </button>
            </>
          )}
        </div>
      </div>
    </div>
  );
};

const CourierDashboard: React.FC = () => {
  const { driverId } = useParams<{ driverId: string }>();
  const [activeTab, setActiveTab] = useState<TabKey>('Assignées');
  const [stats, setStats] = useState<CourierDashboardStats | null>(null);
  const [deliveries, setDeliveries] = useState<CourierDelivery[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [courier, setCourier] = useState<User | null>(null);
  const [updatingDelivery, setUpdatingDelivery] = useState<number | null>(null);

  const handleLogout = () => {
    AuthService.logout();
  };

  // Validate courier access
  const validateCourierAccess = (): { isValid: boolean; error?: string } => {
    console.log("🔐 COURIER ACCESS VALIDATION:");
    
    const token = localStorage.getItem('jwt');
    if (!token) {
      console.error("❌ No JWT token found");
      return { isValid: false, error: "No authentication token" };
    }

    const authValidation = AuthService.validateRole('DELIVERY_DRIVER');
    console.log("🔍 AuthService validation:", authValidation);
    
    if (!authValidation.isValid || !authValidation.userId) {
      console.error("❌ AuthService validation failed:", authValidation);
      return { isValid: false, error: "Courier authentication failed" };
    }
    
    console.log("✅ Courier access validated");
    return { isValid: true };
  };

  // Load courier data
  useEffect(() => {
    const loadCourierData = async () => {
      try {
        setLoading(true);
        setError(null);

        // Validate access
        const accessValidation = validateCourierAccess();
        if (!accessValidation.isValid) {
          setError(`Access denied: ${accessValidation.error}`);
          console.error("🚫 Courier access denied, logging out...");
          AuthService.logout();
          return;
        }

        console.log("🔍 COURIER DASHBOARD - Loading data...");
        console.log("🔍 Driver ID from URL:", driverId);

        // Load all data in parallel
        const [statsData, deliveriesData, courierProfile] = await Promise.all([
          courierService.getDashboardStats(),
          courierService.getDeliveries(),
          courierService.getCourierProfile()
        ]);

        setStats(statsData);
        setDeliveries(deliveriesData);
        setCourier(courierProfile);

        console.log("✅ COURIER DASHBOARD - Data loaded successfully:");
        console.log("- Stats:", statsData);
        console.log("- Deliveries count:", deliveriesData.length);
        console.log("- Courier:", courierProfile);
        
      } catch (err: any) {
        console.error('Error loading courier data:', err);
        if (err.status === 403) {
          setError('Access denied. Please ensure you have delivery driver privileges.');
          AuthService.logout();
        } else if (err.status === 401) {
          setError('Authentication failed. Please login again.');
          AuthService.logout();
        } else {
          setError(err.message || 'Failed to load courier data');
        }
      } finally {
        setLoading(false);
      }
    };

    loadCourierData();
  }, [driverId]);

  // Update delivery status
  const handleStatusUpdate = async (deliveryId: number, newStatus: 'DISPATCHED' | 'IN_TRANSIT' | 'DELIVERED') => {
    try {
      setUpdatingDelivery(deliveryId);
      
      console.log(`🔄 Updating delivery ${deliveryId} to status: ${newStatus}`);
      
      await courierService.updateDeliveryStatus(deliveryId, newStatus);
      
      // Refresh deliveries
      const updatedDeliveries = await courierService.getDeliveries();
      const updatedStats = await courierService.getDashboardStats();
      
      setDeliveries(updatedDeliveries);
      setStats(updatedStats);
      
      console.log(`✅ Delivery ${deliveryId} status updated to: ${newStatus}`);
      
    } catch (err: any) {
      console.error('Error updating delivery status:', err);
      alert(`Erreur lors de la mise à jour: ${err.message}`);
    } finally {
      setUpdatingDelivery(null);
    }
  };

  // Accept delivery
  const handleAcceptDelivery = async (deliveryId: number) => {
    try {
      setUpdatingDelivery(deliveryId);
      
      console.log(`✅ Accepting delivery ${deliveryId}`);
      
      await courierService.acceptDelivery(deliveryId);
      
      // Refresh data
      const updatedDeliveries = await courierService.getDeliveries();
      const updatedStats = await courierService.getDashboardStats();
      
      setDeliveries(updatedDeliveries);
      setStats(updatedStats);
      
      console.log(`✅ Delivery ${deliveryId} accepted`);
      
    } catch (err: any) {
      console.error('Error accepting delivery:', err);
      alert(`Erreur lors de l'acceptation: ${err.message}`);
    } finally {
      setUpdatingDelivery(null);
    }
  };

  // Refuse delivery
  const handleRefuseDelivery = async (deliveryId: number) => {
    try {
      setUpdatingDelivery(deliveryId);
      
      console.log(`❌ Refusing delivery ${deliveryId}`);
      
      await courierService.refuseDelivery(deliveryId);
      
      // Refresh data
      const updatedDeliveries = await courierService.getDeliveries();
      const updatedStats = await courierService.getDashboardStats();
      
      setDeliveries(updatedDeliveries);
      setStats(updatedStats);
      
      console.log(`❌ Delivery ${deliveryId} refused`);
      
    } catch (err: any) {
      console.error('Error refusing delivery:', err);
      alert(`Erreur lors du refus: ${err.message}`);
    } finally {
      setUpdatingDelivery(null);
    }
  };

  // Filter deliveries by status for different tabs
  const getFilteredDeliveries = (tabKey: TabKey): CourierDelivery[] => {
    console.log("🔍 FILTERING DELIVERIES FOR TAB:", tabKey);
    console.log("📋 Total deliveries loaded:", deliveries.length);
    
    let filtered: CourierDelivery[] = [];
    
    switch (tabKey) {
      case 'Assignées':
        filtered = deliveries.filter(delivery => delivery.status.toUpperCase() === 'DISPATCHED');
        console.log("📋 DISPATCHED deliveries found:", filtered.length);
        break;
      case 'En Cours':
        filtered = deliveries.filter(delivery => delivery.status.toUpperCase() === 'IN_TRANSIT');
        console.log("📋 IN_TRANSIT deliveries found:", filtered.length);
        break;
      case 'Historique':
        filtered = deliveries.filter(delivery => delivery.status.toUpperCase() === 'DELIVERED');
        console.log("📋 DELIVERED deliveries found:", filtered.length);
        break;
      default:
        filtered = deliveries;
    }
    
    console.log("📋 Filtered deliveries for", tabKey, ":", filtered);
    return filtered;
  };

  const getUserDisplayName = (): string => {
    if (!courier) return 'Livreur';
    
    const firstName = courier.firstName?.trim();
    const lastName = courier.name?.trim();
    
    if (firstName && lastName) {
      return `${firstName} ${lastName}`;
    } else if (firstName || lastName) {
      return firstName || lastName;
    } else {
      return courier.email;
    }
  };

  if (loading) {
    return (
      <div className="flex justify-center items-center min-h-screen bg-gray-50">
        <div className="text-center">
          <FaSpinner className="mx-auto mb-4 text-4xl text-blue-500 animate-spin" />
          <p className="text-gray-600">Chargement du tableau de bord livreur...</p>
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="flex justify-center items-center min-h-screen bg-gray-50">
        <div className="p-8 max-w-md bg-white rounded-xl shadow-md text-center">
          <FaExclamationTriangle className="mx-auto mb-4 text-4xl text-red-500" />
          <h2 className="mb-4 text-xl font-bold text-red-600">Erreur d'accès</h2>
          <p className="mb-4 text-gray-700">{error}</p>
          <button
            onClick={handleLogout}
            className="px-6 py-2 text-white bg-blue-600 rounded hover:bg-blue-700"
          >
            Retour à la connexion
          </button>
        </div>
      </div>
    );
  }

  const tabContent: Record<TabKey, JSX.Element> = {
    'Assignées': (
      <div className="space-y-4">
        <h2 className="text-xl font-semibold text-gray-800">Livraisons Assignées</h2>
        <p className="text-gray-600">Nouvelles livraisons prêtes à être récupérées</p>
        
        {getFilteredDeliveries('Assignées').length === 0 ? (
          <div className="py-8 text-center text-gray-500">
            <FaBox className="mx-auto mb-4 text-4xl text-gray-300" />
            <p className="text-lg">Aucune livraison assignée</p>
            <p className="text-sm">Les nouvelles livraisons apparaîtront ici</p>
          </div>
        ) : (
          <div className="grid gap-4 md:grid-cols-1 lg:grid-cols-1">
            {getFilteredDeliveries('Assignées').map((delivery) => (
              <DeliveryCard
                key={delivery.id}
                delivery={delivery}
                onStatusUpdate={handleStatusUpdate}
                onAccept={handleAcceptDelivery}
                onRefuse={handleRefuseDelivery}
                isUpdating={updatingDelivery === delivery.id}
                showActions={true}
              />
            ))}
          </div>
        )}
      </div>
    ),

    'En Cours': (
      <div className="space-y-4">
        <h2 className="text-xl font-semibold text-gray-800">Livraisons en Cours</h2>
        <p className="text-gray-600">Livraisons en cours de transport</p>
        
        {getFilteredDeliveries('En Cours').length === 0 ? (
          <div className="py-8 text-center text-gray-500">
            <FaTruck className="mx-auto mb-4 text-4xl text-gray-300" />
            <p className="text-lg">Aucune livraison en cours</p>
            <p className="text-sm">Les livraisons en transport apparaîtront ici</p>
          </div>
        ) : (
          <div className="grid gap-4 md:grid-cols-1 lg:grid-cols-1">
            {getFilteredDeliveries('En Cours').map((delivery) => (
              <DeliveryCard
                key={delivery.id}
                delivery={delivery}
                onStatusUpdate={handleStatusUpdate}
                onAccept={handleAcceptDelivery}
                onRefuse={handleRefuseDelivery}
                isUpdating={updatingDelivery === delivery.id}
                showActions={false}
              />
            ))}
          </div>
        )}
      </div>
    ),

    'Historique': (
      <div className="space-y-4">
        <h2 className="text-xl font-semibold text-gray-800">Historique</h2>
        <p className="text-gray-600">Livraisons terminées</p>
        
        {getFilteredDeliveries('Historique').length === 0 ? (
          <div className="py-8 text-center text-gray-500">
            <FaCheckCircle className="mx-auto mb-4 text-4xl text-gray-300" />
            <p className="text-lg">Aucune livraison terminée</p>
            <p className="text-sm">L'historique des livraisons apparaîtra ici</p>
          </div>
        ) : (
          <div className="grid gap-4 md:grid-cols-1 lg:grid-cols-1">
            {getFilteredDeliveries('Historique').map((delivery) => (
              <DeliveryCard
                key={delivery.id}
                delivery={delivery}
                onStatusUpdate={handleStatusUpdate}
                onAccept={handleAcceptDelivery}
                onRefuse={handleRefuseDelivery}
                isUpdating={updatingDelivery === delivery.id}
                showActions={false}
              />
            ))}
          </div>
        )}
      </div>
    ),
  };

  return (
    <div className="min-h-screen bg-gray-50 py-8 px-4">
      <div className="max-w-6xl mx-auto space-y-8">
        
        {/* Header */}
        <div className="flex justify-between items-center bg-white p-6 rounded-xl shadow-sm">
          <div className="flex items-center">
            <div className="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mr-4">
              <FaTruck className="text-2xl text-blue-600" />
            </div>
            <div>
              <h1 className="text-2xl font-bold text-gray-800">
                Tableau de Bord Livreur
              </h1>
              <p className="text-gray-600">
                Connecté comme: DELIVERY_DRIVER • {getUserDisplayName()}
              </p>
            </div>
          </div>
          <button
            onClick={handleLogout}
            className="flex items-center px-4 py-2 text-gray-600 hover:text-red-600 transition-colors"
          >
            <FaSignOutAlt className="mr-2" />
            Déconnexion
          </button>
        </div>

        {/* Statistics */}
        {stats && (
          <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
            <StatCard
              title="Total"
              value={stats.totalDeliveries.toString()}
              icon={<FaBox className="text-xl" />}
            />
            <StatCard
              title="Assignées"
              value={stats.assignedDeliveries.toString()}
              icon={<FaClock className="text-xl" />}
            />
            <StatCard
              title="En Transit"
              value={stats.inTransitDeliveries.toString()}
              icon={<FaTruck className="text-xl" />}
            />
            <StatCard
              title="Livrées"
              value={stats.deliveredCount.toString()}
              icon={<FaCheckCircle className="text-xl" />}
            />
          </div>
        )}

        {/* Tabs */}
        <div className="bg-white rounded-xl shadow-sm">
          <Tabs
            activeTab={activeTab}
            onChange={(tab) => setActiveTab(tab as TabKey)}
            tabs={['Assignées', 'En Cours', 'Historique']}
          />
          
          <div className="p-6">
            {tabContent[activeTab]}
          </div>
        </div>
      </div>
    </div>
  );
};

export default CourierDashboard; 